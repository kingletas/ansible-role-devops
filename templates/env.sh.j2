# {{ ansible_managed }}
# Sourced from the shell rc files; every PATH entry the devops role owns lives
# here so re-running the role never leaves stale blocks behind.

_devops_path_prepend() {
    case ":${PATH}:" in
        *":$1:"*) ;;
        *) [ -d "$1" ] && PATH="$1:${PATH}" ;;
    esac
}

_devops_path_prepend "${HOME}/.local/bin"
_devops_path_prepend "{{ devops_bin_dir }}"
{% if devops__enabled.nodejs | default(false) %}

# Node.js -- global npm installs land in the user's prefix, no sudo required
_devops_path_prepend "${HOME}/{{ devops_npm_prefix }}/bin"
export MANPATH="${HOME}/{{ devops_npm_prefix }}/share/man:${MANPATH:-$(manpath 2>/dev/null)}"
{% endif %}
{% if devops__enabled.go | default(false) %}

# Go
_devops_path_prepend "{{ devops_go_install_dir }}/go/bin"
_devops_path_prepend "${HOME}/go/bin"
{% endif %}
{% if devops__enabled.php | default(false) %}

# Composer
export COMPOSER_HOME="{{ devops_composer_home }}"
_devops_path_prepend "${COMPOSER_HOME}/vendor/bin"
alias grumpit='grumphp run -c {{ devops_php_config_dir }}/grumphp.yml'
{% endif %}
{% if devops__enabled.warden | default(false) %}

# Warden
_devops_path_prepend "{{ devops_warden_dir }}/bin"
{% endif %}

export PATH
unset -f _devops_path_prepend
{% if devops__enabled.hashicorp | default(false) and devops_hashicorp_packages.terraform | default(false) %}

# terraform completion (bash only -- zsh users get it from oh-my-zsh)
if [ -n "${BASH_VERSION:-}" ] && command -v terraform >/dev/null 2>&1; then
    complete -C "$(command -v terraform)" terraform
fi
{% endif %}
{% if devops_starship | default(false) %}

if command -v starship >/dev/null 2>&1; then
    if [ -n "${ZSH_VERSION:-}" ]; then
        eval "$(starship init zsh)"
    elif [ -n "${BASH_VERSION:-}" ]; then
        eval "$(starship init bash)"
    fi
fi
{% endif %}
{% if devops_byobu_enable | default(false) %}

[ -r "${HOME}/.byobu/prompt" ] && . "${HOME}/.byobu/prompt"   #byobu-prompt#
{% endif %}
